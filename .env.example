# Copy to .env in the repository root and fill in the database password and JWT secret.
# Keep .env private. Never use these placeholders as actual credentials.
AQUASENSE_DB_PASSWORD=pavan123
# Optional Web application OAuth client ID, also passed to Flutter for Google login.
AQUASENSE_GOOGLE_CLIENT_ID=
# Base64-encoded random secret containing at least 32 bytes (see setup guide).
AQUASENSE_JWT_SECRET=
AQUASENSE_API_PORT=8080
